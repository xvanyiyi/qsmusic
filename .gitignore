# ─────────── 运行时二进制（体积大，且不是本项目产物） ───────────
runtime/
signer/electron/

# ─────────── 本地状态：登录 cookie / 设备标识 / 下载的音乐 / 解密缓存 ───────────
storage/

# 登录配置（只保留 .example）
config/local.php

# ─────────── 汽水音乐客户端的原生库与可执行文件（从客户端复制，受版权保护，不分发） ───────────
*.node
*.dll
*.exe
*.asar

# ─────────── 调试 / 临时产物 ───────────
_*
.tools/
*.zip
*.log
*.tmp
*.enc
*.enc.mp4

# ─────────── 编辑器与系统 ───────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ─────────── Python（RE 脚本残留） ───────────
__pycache__/
*.pyc
